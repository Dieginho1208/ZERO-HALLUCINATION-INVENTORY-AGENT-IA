# Leave empty to run in Demo/Mock mode (no API calls, deterministic offline planner)
ANTHROPIC_API_KEY=
# Any current Claude model ID. Default: claude-opus-5-5 (claude-sonnet-5-5 is a cheaper option)
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
ANTHROPIC_FALLBACKS=default

INVENTORY_DB_PATH=data/inventory.db
SQL_MAX_ROWS=200

# Daily digest delivery (optional)
SLACK_WEBHOOK_URL=
WHATSAPP_API_URL=
WHATSAPP_TOKEN=
WHATSAPP_TO=
